APP_ENV=local
LOG_LEVEL=INFO

# HTTP API bind (required for `seleric-api`)
API_HOST=127.0.0.1
API_PORT=8000

# Persistence: memory (tests) | file (local API without Docker) | postgres
PERSISTENCE_BACKEND=memory
# Local disk snapshot used when PERSISTENCE_BACKEND=file
PERSISTENCE_PATH=.data/persistence
# Host-side tools / local API outside Compose. Compose publishes Postgres on
# POSTGRES_PUBLISH_PORT (default 5433 → container 5432) to avoid clashing with
# other local Postgres (e.g. OpenMetadata on 5432).
# Compose api/recovery ignore this and use COMPOSE_DATABASE_URL / @postgres:5432.
DATABASE_URL=postgresql+psycopg://seleric:seleric@127.0.0.1:5433/seleric_swarm
POSTGRES_PUBLISH_PORT=5433
# Optional override for in-compose services only (defaults to @postgres:5432):
# COMPOSE_DATABASE_URL=postgresql+psycopg://seleric:seleric@postgres:5432/seleric_swarm
# Activity event wakeups: auto | memory | redis. Auto selects Redis only for
# non-development Postgres deployments with REDIS_URL configured.
EVENT_NOTIFIER_BACKEND=auto
REDIS_URL=
# Durable recovery worker. Docker Compose runs:
# seleric-recover --executor seleric_swarm.api.conversations:build_submission_executor
RUN_WORKER_ID=
RUN_LEASE_S=60
RUN_HEARTBEAT_S=15
RUN_MAX_ATTEMPTS=3
RUN_RETRY_DELAY_S=5
RUN_RETRY_JITTER_S=1
SHUTDOWN_TIMEOUT_S=10
RUN_RECOVERY_INTERVAL_S=5

# Attachment/blob storage. Content remains quarantined unless a configured
# malware scanner returns CLEAN.
BLOB_BACKEND=local
BLOB_LOCAL_PATH=.data/attachments
ATTACHMENT_MAX_SIZE_BYTES=26214400
ATTACHMENT_ALLOWED_MIME_TYPES=application/json,application/pdf,text/csv,text/plain,image/jpeg,image/png,image/webp
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=seleric-attachments
MINIO_SECURE=true
# Production requires ClamAV; local/test defaults remain fail-closed and unavailable.
MALWARE_SCANNER_BACKEND=unavailable
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_S=5
READINESS_TIMEOUT_S=2

# LLM provider: fake | azure_openai_compatible
LLM_PROVIDER=fake
LLM_TIMEOUT_S=30
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
LLM_MAX_RETRIES=2
# Extra comma-separated fallback model ids, tried after AZURE_OPENAI_MODEL2 (below).
LLM_FALLBACK_MODELS=
LLM_FALLBACK_MODEL=

# Azure OpenAI / Azure AI Inference — set in .env, never commit real keys
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Single-model deployments: set AZURE_OPENAI_MODEL only.
AZURE_OPENAI_MODEL=
# Multi-model gateway (preferred): first entry is primary, rest are
# fallbacks tried in order — all must be deployed on the same
# AZURE_OPENAI_ENDPOINT. JSON array or comma-separated, either works:
#   AZURE_OPENAI_MODELS=["DeepSeek-V4-Flash","gpt-5-mini"]
#   AZURE_OPENAI_MODELS=DeepSeek-V4-Flash,gpt-5-mini
AZURE_OPENAI_MODELS=
# Legacy numbered fallback, only read when AZURE_OPENAI_MODELS is unset.
AZURE_OPENAI_MODEL1=
AZURE_OPENAI_MODEL2=
AZURE_OPENAI_API_VERSION=2024-05-01-preview
AZURE_AUTH_STYLE=openai_compatible
AZURE_KEY_VAULT_URL=

# Optional second Azure resource (distinct endpoint + key + quota). Appended
# to the fallback chain after every model above, so an endpoint-level 429 on
# the primary resource (not just one deployment) has somewhere to fall back
# to. Same auth style as AZURE_AUTH_STYLE above. Leave empty to disable.
AZURE_OPENAI_ENDPOINT_2=
AZURE_OPENAI_API_KEY_2=
AZURE_OPENAI_MODELS_2=

# Optional independent-provider fallback tier, appended after all Azure models
# in the V3 agent's fallback chain. Survives an Azure-wide 429 by falling through
# to OpenRouter's separate provider pool. OpenAI-compatible; needs no api-version.
# Note: prompts route through a third party — set your OpenRouter account data
# policy to no-logging/ZDR if that matters (docs/47_CONVERSATION_DATA_POLICY.md).
OPENROUTER_API_KEY=
OPENROUTER_MODELS=            # e.g. openai/gpt-4o-mini,deepseek/deepseek-chat
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1

# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_WORKSPACE_ID=
LANGSMITH_ORG=
LANGSMITH_ENDPOINT=

# MCP / registries (paths relative to repo root)
MCP_CONFIG_PATH=config/mcp_servers.yaml
# Local example: http://127.0.0.1:8765/mcp
SELERIC_MCP_URL=
SELERIC_MCP_TOKEN=
METRIC_REGISTRY_PATH=config/metric_registry.yaml
PROMPT_VERSIONS_PATH=config/prompt_versions.yaml
PROMPTS_DIR=prompts
FIXTURES_DIR=data/fixtures

A2A_PUBLIC_BASE_URL=

# Mission budgets
MISSION_TIMEOUT_S=600
MAX_LLM_CALLS=6
MAX_TOOL_CALLS=160
MAX_AGENT_CALLS=30
COMPLETION_THRESHOLD=0.90

ALLOW_WRITE_ACTIONS=false
REQUIRE_PROVENANCE_FOR_NUMERIC=true

# V3 agent loop (PydanticAI). When true, Conversations + POST /v1/missions
# run the new agent instead of swarm_v2. Tests force this off.
V3_AGENT_ENABLED=false

# Production additionally requires a non-empty API_KEY, PostgreSQL persistence
# and checkpoints, Redis cancellation/events, a real LLM, MinIO, and ClamAV.
API_KEY=
