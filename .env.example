APP_ENV=local
LOG_LEVEL=INFO

# Persistence: memory (default for local/CI) or postgres
PERSISTENCE_BACKEND=memory
DATABASE_URL=postgresql+psycopg://seleric:seleric@localhost:5432/seleric_swarm

# LLM provider: fake | azure_openai_compatible
LLM_PROVIDER=fake
LLM_TIMEOUT_S=30
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
LLM_MAX_RETRIES=2
# Fallback models are disabled in V1. Do not set this in production without an experiment.
LLM_FALLBACK_MODEL=

# Azure-hosted Llama 4 Maverick (OpenAI-compatible Azure AI Inference).
# Never commit real keys. Local: this file copied to .env. Deployed: Azure Key Vault.
AZURE_OPENAI_ENDPOINT=https://llama4-maverick-prod-resource.services.ai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
AZURE_OPENAI_API_VERSION=2024-05-01-preview
# openai_compatible = Azure AI Inference (*.services.ai.azure.com); azure = classic Azure OpenAI
AZURE_AUTH_STYLE=openai_compatible

# Optional Key Vault URL for deployed environments (managed identity).
# Secret names: seleric-azure-openai-api-key, seleric-langsmith-api-key
AZURE_KEY_VAULT_URL=

# LangSmith (best-effort: tracing failures must not fail missions)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=seleric-swarm-local
LANGSMITH_WORKSPACE_ID=
LANGSMITH_ORG=default
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# MCP / registries (paths relative to repo root)
MCP_CONFIG_PATH=config/mcp_servers.yaml

# Seleric MCP: consolidated business-data gateway (catalogue + metrics_query/
# drilldown/explain). Never commit a real token.
SELERIC_MCP_URL=https://mcp.seleric.com/mcp
SELERIC_MCP_TOKEN=
METRIC_REGISTRY_PATH=config/metric_registry.yaml
PROMPT_VERSIONS_PATH=config/prompt_versions.yaml
PROMPTS_DIR=prompts
FIXTURES_DIR=data/fixtures

# Agent networking (unused in V1 in-process mode)
A2A_PUBLIC_BASE_URL=http://localhost:8000

# Mission budgets
MISSION_TIMEOUT_S=30
MAX_LLM_CALLS=6
MAX_TOOL_CALLS=8

# Coordinator control-plane hard stops (DECIDE -> EXECUTE cycle)
MAX_AGENT_CALLS=30
MAX_LEADERSHIP_TRANSFERS=6
MAX_COORDINATOR_ITERATIONS=12
COMPLETION_THRESHOLD=0.90

# Safety
ALLOW_WRITE_ACTIONS=false
REQUIRE_SKEPTIC_FOR_CAUSAL=true
REQUIRE_PROVENANCE_FOR_NUMERIC=true
