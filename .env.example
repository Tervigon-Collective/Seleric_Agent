APP_ENV=local
LOG_LEVEL=INFO

# LLM provider abstraction
LLM_PROVIDER=replace_me
LLM_MODEL=replace_me
LLM_API_KEY=replace_me

# State / evidence
DATABASE_URL=postgresql+psycopg://seleric:seleric@localhost:5432/seleric_swarm
REDIS_URL=redis://localhost:6379/0

# MCP gateway
MCP_CONFIG_PATH=config/mcp_servers.local.yaml

# Agent networking
A2A_PUBLIC_BASE_URL=http://localhost:8000

# Safety
ALLOW_WRITE_ACTIONS=false
REQUIRE_SKEPTIC_FOR_CAUSAL=true
REQUIRE_PROVENANCE_FOR_NUMERIC=true
