APP_ENV=local
LOG_LEVEL=INFO

# HTTP API bind (required for `seleric-api`)
API_HOST=127.0.0.1
API_PORT=8000

# Persistence: memory (default for local/CI) or postgres
PERSISTENCE_BACKEND=memory
DATABASE_URL=

# LLM provider: fake | azure_openai_compatible
LLM_PROVIDER=fake
LLM_TIMEOUT_S=30
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
LLM_MAX_RETRIES=2
LLM_FALLBACK_MODEL=

# Azure OpenAI / Azure AI Inference — set in .env, never commit real keys
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=
AZURE_OPENAI_API_VERSION=2024-05-01-preview
AZURE_AUTH_STYLE=openai_compatible
AZURE_KEY_VAULT_URL=

# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_WORKSPACE_ID=
LANGSMITH_ORG=
LANGSMITH_ENDPOINT=

# MCP / registries (paths relative to repo root)
MCP_CONFIG_PATH=config/mcp_servers.yaml
# Local example: http://127.0.0.1:8765/mcp
SELERIC_MCP_URL=
SELERIC_MCP_TOKEN=
METRIC_REGISTRY_PATH=config/metric_registry.yaml
PROMPT_VERSIONS_PATH=config/prompt_versions.yaml
PROMPTS_DIR=prompts
FIXTURES_DIR=data/fixtures

A2A_PUBLIC_BASE_URL=

# Mission budgets
MISSION_TIMEOUT_S=30
MAX_LLM_CALLS=6
MAX_TOOL_CALLS=8
MAX_AGENT_CALLS=30
MAX_LEADERSHIP_TRANSFERS=6
MAX_COORDINATOR_ITERATIONS=12
COMPLETION_THRESHOLD=0.90

ALLOW_WRITE_ACTIONS=false
REQUIRE_SKEPTIC_FOR_CAUSAL=true
REQUIRE_PROVENANCE_FOR_NUMERIC=true
