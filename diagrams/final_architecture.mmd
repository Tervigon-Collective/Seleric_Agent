    TM --> BB
    OA --> EL --> BB
    LS --> AGR
    HT --> AGR
    AML --> MR
    PML --> MR
    MS --> MTR
    FE --> FR
    CR --> CCR
    BB --> AUD

    subgraph TRUST["VALIDATION GATES"]
        PV["Provenance Validator"]
        EQ["Evidence Quality"]
        CV["Cross-source Validator"]
        MV["Model Reliability / Drift"]
        HC["Unsupported Claim Gate"]
    end

    EL --> PV --> EQ --> CV --> SK
    PML --> MV --> SK
    AML --> MV
    SK --> HC --> CG
