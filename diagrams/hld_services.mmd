        OVOS[OpenVoiceOS]
        Bridge[Seleric Bridge Skill]
        Rec[Meeting Recorder]
        OVOS --> Bridge
        OVOS --> Rec
    end

    subgraph Services[Backend Services]
        VO[Voice Orchestrator]
        BS[Business State]
