            Swarm[Coordinator + 7 Agents]
            BB[(Blackboard)]
            Gov[Governor Enforcement]
        end
        MI[Meeting Intelligence]
        CP[Control Plane<br/>+ Governor Policy]
        AU[Appsmith]
    end

    subgraph Platform[Shared Platform]
        MCP[Seleric MCP]
        PG[(PostgreSQL + pgvector)]
        CH[(ClickHouse)]
        OBJ[(Object Storage)]
        Q[PostgreSQL Task Queue]
        LLM[LLM Provider]
    end

    Bridge <--> VO
    Rec --> MI
    VO --> ID
    ID --> BS
    BS --> MCP
    BS --> CH
    BS --> PG
    ID --> PG
    Swarm <--> LLM
    Gov --> CP
