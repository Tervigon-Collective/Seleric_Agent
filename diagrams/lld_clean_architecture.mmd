flowchart TB
    subgraph API[Inbound Adapters]
        HTTP[FastAPI Controllers]
        Worker[Task Workers]
        Voice[Voice Skill / Device Adapter]
        Admin[Admin Client]
    end

    subgraph App[Application Layer]
        UseCases[Use Cases / Commands / Queries]
        Ports[Inbound and Outbound Ports]
    end

    subgraph Domain[Domain Layer]
        Agg[Aggregates]
        VO[Value Objects]
        Policies[Policies / Specifications]
        Strategies[Strategy Interfaces]
        Events[Domain Events]
    end

    subgraph Out[Outbound Adapters]
        PG[PostgreSQL Repositories]
        MCP[Seleric MCP Adapter]
        CH[ClickHouse Adapter]
        OBJ[Object Store Adapter]
        Speech[STT/TTS Adapters]
        Reason[LLM Reasoning Provider Adapter]
        OTel[Telemetry Adapter]
    end

    API --> UseCases
    UseCases --> Domain
    UseCases --> Ports
    Out -.implements.-> Ports
    Domain --> Events
    Domain -.no dependency on.-> Out
