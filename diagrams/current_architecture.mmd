        FEAT["compute_features()"]
        ROBZ["robust_zscore()"]
        BSS --> FSERIES --> RM
        BSS --> FEAT
        BSS --> ROBZ
    end

    LFP --> BSS
    N_EXECUTE -.-> BSS

    subgraph INTEL["Intelligence specialists"]
        AA["AnomalyAgent<br/>swarm/specialists/"]
