flowchart TB

    U["Client (HTTP)"]
    API["main.py :: create_mission<br/>POST /v1/missions"]
    U --> API

    subgraph ROUTING["orchestration/dispatch.py"]
        RF["route_for()<br/>LLM classify -> lookup | swarm"]
        RAM["run_any_mission()"]
        RF --> RAM
    end

    API -- sync --> RF
    API -- async --> BGJOB["run_mission_job()"]
    BGJOB --> RF

    subgraph LOOKUPPATH["lookup route"]
        LFP["lookup_fast_path.py<br/>run_lookup_fast_path()"]
    end

    RAM -- lookup --> LFP
    LFP -. "None -> retry once<br/>-> ROUTING_UNSUPPORTED" .-> RF

    SWARMENTRY["coordinator/graph.py<br/>run_swarm_v2_mission()"]
    RAM -- swarm --> SWARMENTRY

    subgraph SWARMGRAPH["build_swarm_v2_graph (LangGraph)"]
        N_INTAKE["intake"]
        N_DECOMP["decompose"]
        N_PLAN["plan"]
        N_ASSEMBLE["assemble"]
        N_EXECUTE["execute"]
        N_REFINE["refine"]
        N_SPEC["specialists"]
        N_SKGATE["skeptic_gate"]
        N_REMED["remediate"]
        N_COMPLETE["complete"]
        N_SYNTH["synthesize"]

        N_INTAKE --> N_DECOMP --> N_PLAN --> N_ASSEMBLE --> N_EXECUTE --> N_REFINE
        N_REFINE -- "frontier moved" --> N_EXECUTE
        N_REFINE -- else --> N_SPEC
        N_SPEC --> N_SKGATE
        N_SKGATE -- "REVISE/REJECT" --> N_REMED
        N_SKGATE -- PASS --> N_COMPLETE
        N_SKGATE -- else --> N_SYNTH
        N_REMED --> N_SKGATE
        N_COMPLETE --> N_SYNTH
    end

    CATGROUND["catalogue_grounding.py<br/>ground_live_grain()"]
    N_DECOMP -.-> CATGROUND

    SWARMENTRY --> N_INTAKE
    N_SYNTH --> OUT["MissionResult"]
    LFP --> OUT
    OUT --> U

    subgraph DOMAINMESH["Domain agents — DomainAgent.observe()"]
        PA["performance_agent"]
        ATTR["attribution_agent"]
        CA["commerce_agent"]
        PROD["product_agent"]
        CUST["customer_agent"]
        OPS["operations_agent"]
        FIA["finance_agent"]
        FA["funnel_agent (disabled)"]
    end

    OA["observer_agent"]

    N_EXECUTE --> PA
    N_EXECUTE --> OA
    PA -.-> CA
    CA -.-> PROD
    CA -.-> OPS
    PA -.-> ATTR
    PA -.-> FIA
    CA -.-> FA

    subgraph DATAACCESS["swarm/providers"]
        DP["DataProvider"]
        HMP["HybridMcpDataProvider<br/>.fetch() + .fetch_series()"]
        RM["resolve_measure()"]
        CMQ["call_metrics_query()"]
        DP --> HMP --> RM --> CMQ
    end

    PA --> DP
    ATTR --> DP
    CA --> DP
    PROD --> DP
    CUST --> DP
    OPS --> DP
    FIA --> DP
    OA --> DP

