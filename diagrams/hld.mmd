flowchart LR
    Founder((Founder))
    Participant((Meeting Participant))
    AdminUser((Admin / Analyst))

    subgraph Edge[Physical Edge Node]
        Mic[USB Mic Array]
        Wake[openWakeWord + VAD]
        OVOS[raspOVOS / OpenVoiceOS]
        Skill[Seleric Bridge Skill]
        Recorder[Meeting Recorder + Encrypted Spool]
        Speaker[Speaker]
        Controls[LED + Mute + Stop]
        Mic --> Wake --> OVOS --> Skill
        Mic --> Recorder
        Skill --> Speaker
        Controls --> OVOS
        Controls --> Recorder
    end

    subgraph Access[Access and Operations]
        Ingress[Ingress / TLS]
        IAM[Entra ID or Keycloak]
        Admin[Appsmith Admin UI]
        OTel[OpenTelemetry]
    end

    subgraph Services[Seleric V1 Microservices]
        Voice[Voice Orchestrator]
        Control[Control Plane]
        State[Business State]
        Insight[Insight Decision]
        Meeting[Meeting Intelligence]
    end

    subgraph Existing[Existing Seleric Data Platform]
        MCP[Seleric MCP]
        Cube[Cube Semantic Layer]
        CH[(ClickHouse + Existing Marts)]
    end

    subgraph Storage[Shared Platform]
        PG[(PostgreSQL)]
        Obj[(Blob / MinIO)]
        Queue[PostgreSQL Task Workers]
    end

    subgraph Providers[Replaceable Adapters]
        ManagedSpeech[Managed STT/TTS]
        LocalSpeech[OVOS STT/TTS + Faster Whisper/Piper]
        Dia[WhisperX + pyannote]
    end

    Founder --> Mic
    Participant --> Mic
    AdminUser --> IAM --> Admin --> Ingress --> Control
    Skill <--> Ingress
    Ingress <--> Voice
    Recorder --> Ingress --> Meeting
    Voice --> Insight
    Voice --> Meeting
    Insight --> State
    Insight --> Control
    Meeting --> State
    Meeting --> Control
    State --> Control
    State --> MCP --> Cube --> CH
    Voice <--> ManagedSpeech
    Skill <--> LocalSpeech
    Meeting --> Dia
    Voice --> PG
    Control --> PG
    State --> PG
    State --> CH
    Insight --> PG
    Meeting --> PG
    Meeting --> Obj
    State --> Queue
    Insight --> Queue
    Meeting --> Queue
    OTel -. telemetry .-> Voice
    OTel -. telemetry .-> Control
    OTel -. telemetry .-> State
    OTel -. telemetry .-> Insight
    OTel -. telemetry .-> Meeting
