%% Changed 2026-08-31: RootCauseHypothesis, InterventionCandidate below are retired as
%% deterministic-computation outputs. They are replaced by the Blackboard aggregate
%% (SwarmCase, Hypothesis, AgentMessage, ProposedAction) - see swarm_domain_model.mmd.
%% FounderBrief is kept: its DTO contract to Voice Orchestrator is unchanged (doc 03 SS9),
%% only what populates it changed.
classDiagram
    class BusinessNode {
      +NodeId id
      +NodeType type
      +str name
      +OwnerRef owner
      +set~Tag~ tags
      +bool active
    }
    class BusinessEdge {
      +EdgeId id
      +NodeId from_node
      +NodeId to_node
      +EdgeType type
      +float weight
      +float confidence
      +Duration lag
    }
    class MetricBinding {
      +BindingId id
      +NodeId node_id
      +str metric_id
      +dict dimension_scope
      +float weight
      +FreshnessPolicy freshness
    }
    class GoalDefinition {
      +GoalId id
      +BindingId metric_binding_id
      +Target target
      +Tolerance tolerance
      +Period period
      +Criticality criticality
      +EscalationPolicyId escalation_policy
      +evaluate(actual, baseline) GoalEvaluation
    }
    class MetricState {
      +StateId id
      +MetricKey key
      +Instant as_of
      +decimal actual
      +decimal target
      +decimal baseline
      +Finality finality
      +float data_confidence
      +FeatureSet features
      +list~EvidenceRef~ evidence
    }
    class NodeHealth {
      +NodeId node_id
      +Instant as_of
      +float score
      +HealthBand band
      +float confidence
    }
    class RootCauseHypothesis {
      +HypothesisId id
      +NodeId root_node
      +list~NodeId~ symptoms
      +list~EdgeId~ path
      +float evidence_score
    }
    class InterventionCandidate {
      +InterventionId id
      +str root_cause_key
      +str action
      +OwnerRef owner
      +bool founder_required
      +EligibilityResult eligibility
      +ScoreBreakdown score
    }
    class FounderBrief {
      +BriefId id
      +Instant as_of
      +list~InterventionCandidate~ selected
      +DecisionTraceId trace_id
    }
    class Meeting {
      +MeetingId id
      +MeetingStatus status
      +Instant started_at
      +Instant stopped_at
      +start()
      +stop()
    }
    class Utterance {
      +UtteranceId id
      +SpeakerLabel speaker
      +PersonRef person
      +str text
      +Duration start
      +Duration end
    }
    class Commitment {
      +CommitmentId id
      +MeetingId meeting_id
      +PersonRef owner
      +str action
      +Instant deadline
      +str expected_outcome
      +CommitmentStatus status
      +approve()
      +mark_verified()
      +mark_breached()
    }
    class VerificationRule {
      +RuleId id
      +str adapter_id
      +dict parameters
      +Duration grace_period
      +str version
    }
    BusinessNode "1" --> "*" MetricBinding
    BusinessNode "1" --> "*" GoalDefinition
    BusinessNode "1" --> "*" BusinessEdge
    MetricBinding "1" --> "*" MetricState
    BusinessNode "1" --> "*" NodeHealth
    RootCauseHypothesis --> BusinessNode
    InterventionCandidate --> RootCauseHypothesis
    FounderBrief o-- InterventionCandidate
    Meeting o-- Utterance
    Meeting o-- Commitment
    Commitment --> VerificationRule
