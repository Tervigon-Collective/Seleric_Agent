          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const id = body.mission_id || body.missionId;",
                  "if (id) pm.environment.set('mission_id', id);",
                  "if (body.run_id) pm.environment.set('run_id', body.run_id);"
                ]
              }
